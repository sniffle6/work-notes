        },
        "textPrimary": {
          "type": "string"
        },
        "textMuted": {
          "type": "string"
        },
        "accentPrimary": {
          "type": "string"
        },
        "accentHot": {
          "type": "string"
        },
        "statusSuccess": {
          "type": "string"
